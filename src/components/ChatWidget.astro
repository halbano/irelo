---
// Static support/chat placeholder — NOT a React island, no hydration.
// Uses native <details> for open/close (zero JS). Desktop: a prompt card open
// by default (collapsible). Mobile: a tappable bubble that expands, sitting
// above the sticky CTA bar. Clearly a placeholder — links to call/email, no
// real chat backend.
const EMAIL = "hello@straightaway.example";
const PHONE = "(888) 555-0142";
---

<!-- Desktop: open-by-default prompt card (collapsible, no JS) -->
<details
  open
  class="group fixed right-6 bottom-6 z-40 hidden w-[20rem] lg:block"
>
  <summary
    class="flex cursor-pointer list-none items-center justify-between gap-2 rounded-t-2xl rounded-b-2xl border border-border bg-navy px-4 py-3 text-sm font-semibold text-white shadow-lg group-open:rounded-b-none"
  >
    <span class="flex items-center gap-2">
      <span class="relative flex size-2.5">
        <span class="absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75 motion-safe:animate-ping"></span>
        <span class="relative inline-flex size-2.5 rounded-full bg-green-400"></span>
      </span>
      Chat with our team
    </span>
    <svg viewBox="0 0 24 24" class="size-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </summary>
  <div class="rounded-b-2xl border border-t-0 border-border bg-card p-4 shadow-lg">
    <p class="text-sm text-muted-foreground">
      Real people, typically reply in ~2 minutes. Having trouble with your quote? We're here.
    </p>
    <div class="mt-3 flex flex-col gap-2">
      <a
        href={`mailto:${EMAIL}`}
        class="flex h-10 items-center justify-center rounded-md bg-cta text-sm font-semibold text-cta-foreground transition-transform motion-safe:hover:-translate-y-0.5"
      >
        Start a chat
      </a>
      <a
        href={`tel:+18885550142`}
        class="flex h-10 items-center justify-center rounded-md border border-border text-sm font-semibold text-navy"
      >
        Or call {PHONE}
      </a>
    </div>
  </div>
</details>

<!-- Mobile: tappable bubble that expands (sits above the sticky CTA bar) -->
<details class="group fixed right-4 bottom-20 z-40 lg:hidden">
  <summary
    aria-label="Chat with our team or get help"
    class="flex size-14 cursor-pointer list-none items-center justify-center rounded-full bg-navy text-white shadow-lg group-open:hidden"
  >
    <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
  </summary>
  <div class="w-[16rem] rounded-2xl border border-border bg-card p-4 shadow-xl">
    <p class="text-sm font-semibold text-navy">Chat with our team</p>
    <p class="mt-1 text-sm text-muted-foreground">
      Tap to chat, or if you're having trouble with your quote we'll help you finish it.
    </p>
    <div class="mt-3 flex flex-col gap-2">
      <a
        href={`mailto:${EMAIL}`}
        class="flex h-10 items-center justify-center rounded-md bg-cta text-sm font-semibold text-cta-foreground"
      >
        Start a chat
      </a>
      <a
        href={`tel:+18885550142`}
        class="flex h-10 items-center justify-center rounded-md border border-border text-sm font-semibold text-navy"
      >
        Call {PHONE}
      </a>
    </div>
  </div>
</details>
