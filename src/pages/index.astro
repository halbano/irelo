---
import Layout from "@/layouts/Layout.astro";
import QuoteForm from "@/components/QuoteForm.tsx";
import { assignVariant, FORM_EXPERIMENT } from "@/lib/experiment";
import { track } from "@/lib/track";

// A/B test: server-side variant assignment (sticky cookie). Logged as an
// exposure so the experiment is measurable. No client-side flicker.
const variant = assignVariant(Astro.cookies, Astro.url);
track({ event: "experiment_exposure", experiment: FORM_EXPERIMENT, variant });

const PHONE = "(888) 555-0142";
const PHONE_HREF = "tel:+18885550142";

const steps = [
  {
    n: "1",
    title: "Tell us your route",
    body: "Two ZIPs, your vehicle, and a ship date. About two minutes — no account needed.",
  },
  {
    n: "2",
    title: "We match verified carriers",
    body: "We ping our network of FMCSA-licensed carriers for your exact lane and surface a real price.",
  },
  {
    n: "3",
    title: "Your car ships door-to-door",
    body: "A vetted carrier confirms pickup and delivers to your door, fully insured in transit.",
  },
];

const badges = ["Fully insured in transit", "FMCSA licensed", "USDOT registered", "BBB accredited"];

// Invented carrier names — NOT real brands. Real logos would imply partnerships
// we don't have; these are clearly Straightaway's own demo network.
const carriers = [
  "RoadRunner Auto",
  "TransGlobal Freight",
  "Apex Carriers",
  "MetroMove",
  "Summit Auto Haul",
];

const testimonials = [
  {
    quote:
      "Quote in two minutes, carrier confirmed the same day. My car went from Phoenix to Chicago without a scratch.",
    name: "Marcus T.",
    route: "Phoenix → Chicago",
  },
  {
    quote:
      "I'd been quoted all over the place by brokers. Straightaway gave me one real price and stuck to it. No surprise fees at pickup.",
    name: "Dana R.",
    route: "Seattle → Austin",
  },
  {
    quote:
      "First time shipping a car and I was nervous. The carrier was insured, on time, and texted me at every step.",
    name: "Priya K.",
    route: "Miami → Denver",
  },
  {
    quote:
      "Used them for my son's car at college. Easy form, fair price, and they didn't blow up my phone with spam calls.",
    name: "Robert L.",
    route: "Boston → Atlanta",
  },
];

const faqs = [
  {
    q: "How is my price calculated?",
    a: "Auto-transport pricing is route-based — distance, your vehicle size, and current carrier demand on your lane. We pull a live quote for your exact ZIPs instead of quoting a national average.",
  },
  {
    q: "Is my car insured during transport?",
    a: "Yes. Every carrier we match is FMCSA-licensed and carries cargo insurance that covers your vehicle in transit, door to door.",
  },
  {
    q: "Do you sell my contact information?",
    a: "No. Your details are used only to match you with carriers for this shipment. We don't resell your information to third parties.",
  },
  {
    q: "When should I book?",
    a: "Most lanes book 3–7 days out. Flexible pickup dates usually mean better pricing, since carriers can fit you into an existing route.",
  },
];
---

<Layout>
  <!-- Header -->
  <header id="top" class="border-b border-border bg-background">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3.5">
      <a href="#top" class="flex items-center gap-2 font-serif text-xl font-semibold text-navy">
        <svg viewBox="0 0 24 24" class="size-6 text-navy" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M3 12h18M14 7l5 5-5 5"></path>
        </svg>
        Straightaway
      </a>
      <a href={PHONE_HREF} class="text-sm font-semibold text-navy hover:underline">{PHONE}</a>
    </div>
  </header>

  <main>
    <!-- Hero -->
    <section class="mx-auto max-w-6xl px-4 pt-10 pb-12 sm:pt-14">
      <div class="grid gap-8 lg:grid-cols-2 lg:items-start lg:gap-12">
        <!-- Heading -->
        <div class="lg:col-start-1 lg:row-start-1">
          <p class="text-sm font-semibold tracking-wide text-navy uppercase">
            Door-to-door auto transport
          </p>
          <h1 class="mt-3 text-4xl leading-[1.1] font-bold tracking-tight text-foreground sm:text-5xl">
            Get your car on the road,
            <span class="font-serif font-semibold text-navy italic"> straightaway.</span>
          </h1>
          <p class="mt-4 max-w-md text-lg text-muted-foreground">
            Compare door-to-door auto-transport quotes from <strong class="font-semibold text-foreground">120+ vetted carriers</strong>
            and save up to <strong class="font-semibold text-foreground">$450*</strong> on your move with Straightaway's instant-match tool.
          </p>
          <p class="mt-2 text-xs text-muted-foreground">
            *Average reported savings vs. first broker quote. Actual price varies by route and vehicle.
          </p>
        </div>

        <!-- Trust (below form on mobile, under heading on desktop) -->
        <div class="order-last lg:order-none lg:col-start-1 lg:row-start-2">
          <dl class="flex flex-wrap gap-x-8 gap-y-4">
            <div>
              <dt class="text-2xl font-bold text-navy">12,000+</dt>
              <dd class="text-sm text-muted-foreground">cars shipped</dd>
            </div>
            <div>
              <dt class="text-2xl font-bold text-navy">4.8 / 5</dt>
              <dd class="text-sm text-muted-foreground">from 1,900+ shippers</dd>
            </div>
            <div>
              <dt class="text-2xl font-bold text-navy">48 states</dt>
              <dd class="text-sm text-muted-foreground">door-to-door</dd>
            </div>
          </dl>
          <ul class="mt-5 flex flex-wrap gap-2">
            {
              badges.map((b) => (
                <li class="flex items-center gap-1.5 rounded-full border border-border bg-card px-3 py-1.5 text-xs font-medium text-navy">
                  <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 6 9 17l-5-5"></path>
                  </svg>
                  {b}
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Form island — the only hydrated component on the page (A/B variant set server-side) -->
        <div class="lg:col-start-2 lg:row-span-2 lg:row-start-1" data-variant={variant}>
          <QuoteForm variant={variant} client:idle />
          <!-- Trustpilot placeholder (no outbound link — clearly a placeholder) -->
          <div class="mt-3 flex items-center justify-center gap-2 text-sm text-muted-foreground">
            <span class="flex" aria-hidden="true">
              {
                Array.from({ length: 5 }).map(() => (
                  <svg viewBox="0 0 24 24" class="size-4 fill-[#00b67a] text-[#00b67a]" aria-hidden="true">
                    <path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
                  </svg>
                ))
              }
            </span>
            <span><span class="font-semibold text-foreground">Trustpilot</span> · 4.8 · 1,900+ reviews</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Carrier network logo strip -->
    <section class="border-y border-border bg-card">
      <div class="mx-auto max-w-6xl px-4 py-6">
        <p class="text-center text-xs font-semibold tracking-wide text-muted-foreground uppercase">
          Carriers in our network
        </p>
        <ul class="mt-4 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 sm:gap-x-12">
          {
            carriers.map((c) => (
              <li class="text-base font-bold tracking-tight text-navy/70 sm:text-lg">{c}</li>
            ))
          }
          <li class="text-sm font-semibold text-muted-foreground">120+ more</li>
        </ul>
      </div>
    </section>

    <!-- Testimonials -->
    <section class="mx-auto max-w-6xl px-4 py-14">
      <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-center">
        What our customers say
      </h2>
      <p class="mt-2 text-muted-foreground sm:text-center">
        Real moves, real routes — a few of the 12,000+ cars we've shipped.
      </p>
      <ul
        class="mt-8 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-3 sm:grid sm:grid-cols-2 sm:overflow-visible lg:grid-cols-4 [scrollbar-width:none]"
      >
        {
          testimonials.map((t) => (
            <li class="flex min-w-[82%] shrink-0 snap-start flex-col rounded-2xl border border-border bg-card p-5 sm:min-w-0 sm:shrink">
              <div class="flex" aria-hidden="true">
                {Array.from({ length: 5 }).map(() => (
                  <svg viewBox="0 0 24 24" class="size-4 fill-cta text-cta">
                    <path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                  </svg>
                ))}
              </div>
              <p class="mt-3 flex-1 text-sm text-foreground">“{t.quote}”</p>
              <p class="mt-4 text-sm font-semibold text-navy">{t.name}</p>
              <p class="text-xs text-muted-foreground">{t.route}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- How it works -->
    <section class="mx-auto max-w-6xl px-4 py-14">
      <h2 class="text-center text-3xl font-bold tracking-tight text-foreground">How it works</h2>
      <p class="mx-auto mt-2 max-w-lg text-center text-muted-foreground">
        Three steps from quote to delivery. No dealer markups, no surprise fees.
      </p>
      <ol class="mt-10 grid gap-6 sm:grid-cols-3">
        {
          steps.map((s) => (
            <li class="rounded-2xl border border-border bg-card p-6">
              <span class="flex size-9 items-center justify-center rounded-full bg-navy text-sm font-bold text-white">
                {s.n}
              </span>
              <h3 class="mt-4 text-lg font-semibold text-foreground">{s.title}</h3>
              <p class="mt-1.5 text-sm text-muted-foreground">{s.body}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- Methodology / trust -->
    <section class="border-y border-border bg-card">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-14 lg:grid-cols-2 lg:items-center">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-foreground">
            How we match you with carriers
          </h2>
          <p class="mt-4 text-muted-foreground">
            We're a transparent marketplace, not a single carrier. When you request a quote, we
            ping licensed carriers running your lane and show you a real price for your route —
            not a teaser rate that climbs at pickup.
          </p>
          <p class="mt-3 text-muted-foreground">
            We only match carriers with active FMCSA operating authority and valid cargo insurance.
            You get matched once — we don't blast your number across a dozen brokers.
          </p>
        </div>
        <ul class="grid gap-3 sm:grid-cols-2">
          {
            badges.map((b) => (
              <li class="flex items-center gap-2.5 rounded-xl border border-border bg-background px-4 py-3 text-sm font-medium text-navy">
                <svg viewBox="0 0 24 24" class="size-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"></path>
                  <path d="m9 12 2 2 4-4"></path>
                </svg>
                {b}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- FAQ -->
    <section class="mx-auto max-w-3xl px-4 py-14">
      <h2 class="text-center text-3xl font-bold tracking-tight text-foreground">Questions, answered</h2>
      <div class="mt-8 divide-y divide-border border-y border-border">
        {
          faqs.map((f) => (
            <details class="group py-4">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-semibold text-foreground">
                {f.q}
                <svg viewBox="0 0 24 24" class="size-5 shrink-0 text-muted-foreground transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m6 9 6 6 6-6"></path>
                </svg>
              </summary>
              <p class="mt-3 text-sm text-muted-foreground">{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <!-- CTA band -->
    <section class="border-t border-border bg-navy">
      <div class="mx-auto max-w-6xl px-4 py-12 text-center">
        <h2 class="font-serif text-3xl font-semibold text-white italic">
          Ready to ship, straightaway?
        </h2>
        <p class="mx-auto mt-3 max-w-md text-white/70">
          Get your route quote in about two minutes. Free, no spam, no obligation.
        </p>
        <a
          href="#top"
          class="mt-6 inline-flex h-12 items-center rounded-md bg-cta px-8 font-semibold text-cta-foreground transition-colors hover:bg-cta-hover"
        >
          Get my quote
        </a>
      </div>
    </section>
  </main>

  <footer class="bg-navy pb-24 lg:pb-8">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 px-4 py-6 text-sm text-white/60 sm:flex-row">
      <span class="font-serif text-base font-semibold text-white">Straightaway</span>
      <span>© 2025 Straightaway. A demo brand built for an assessment.</span>
      <a href={PHONE_HREF} class="font-medium text-white hover:underline">{PHONE}</a>
    </div>
  </footer>

  <!-- Sticky mobile CTA: revealed once the hero form scrolls out of view -->
  <div
    id="sticky-cta"
    class="fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-border bg-card/95 backdrop-blur transition-transform duration-200 motion-reduce:transition-none data-[show=true]:translate-y-0 lg:hidden"
  >
    <div class="flex items-center gap-3 px-4 py-2.5">
      <a
        href={PHONE_HREF}
        aria-label="Call Straightaway"
        class="flex h-11 items-center gap-2 rounded-md border border-border px-3 text-sm font-semibold text-navy"
      >
        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"></path>
        </svg>
        Call
      </a>
      <a
        href="#top"
        class="flex h-11 flex-1 items-center justify-center rounded-md bg-cta font-semibold text-cta-foreground"
      >
        Get quote →
      </a>
    </div>
  </div>

  <script>
    // Progressive enhancement (not a React island): reveal the mobile sticky bar
    // once the hero form is no longer visible. No-op if elements are absent.
    const bar = document.getElementById("sticky-cta");
    const hero = document.querySelector("form");
    if (bar && hero && "IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        ([entry]) => bar.setAttribute("data-show", String(!entry.isIntersecting)),
        { rootMargin: "-80px 0px 0px 0px" },
      );
      io.observe(hero);
    }
  </script>
</Layout>
