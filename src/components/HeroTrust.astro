---
// Hero trust block: headline stats + regulatory badge chips (white-on-navy).
// Sits below the form on mobile and in its own column row on desktop (both variants).
interface Props {
  badges: string[];
}
const { badges } = Astro.props;
---

<div>
  <dl class="flex flex-wrap gap-x-8 gap-y-4">
    <div>
      <dt class="text-2xl font-bold text-white">12,000+</dt>
      <dd class="text-sm text-white/60">cars shipped</dd>
    </div>
    <div>
      <dt class="text-2xl font-bold text-white">4.8 / 5</dt>
      <dd class="text-sm text-white/60">from 1,900+ shippers</dd>
    </div>
    <div>
      <dt class="text-2xl font-bold text-white">48 states</dt>
      <dd class="text-sm text-white/60">door-to-door</dd>
    </div>
  </dl>
  <ul class="mt-5 flex flex-wrap gap-2">
    {
      badges.map((b) => (
        <li class="flex items-center gap-1.5 rounded-full border border-white/20 bg-white/10 px-3 py-1.5 text-xs font-medium text-white">
          <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 6 9 17l-5-5" />
          </svg>
          {b}
        </li>
      ))
    }
  </ul>
</div>
